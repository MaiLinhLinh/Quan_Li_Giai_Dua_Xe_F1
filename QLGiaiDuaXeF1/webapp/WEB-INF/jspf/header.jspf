<%@ page pageEncoding="UTF-8" %>
<%@ page import="f1.model.BanToChuc, f1.util.HtmlUtil, f1.util.TextEncodingUtil" %>
<%
    String ctx = request.getContextPath();
    BanToChuc btcNav = (BanToChuc) session.getAttribute("banToChuc");
    String navHoTen = btcNav == null ? "" : TextEncodingUtil.repairMojibake(btcNav.getHoTen());
    String navViTri = btcNav == null ? "" : TextEncodingUtil.repairMojibake(btcNav.getViTriCongViec());
    String pageTitle = (String) request.getAttribute("pageTitle");
    if (pageTitle == null) {
        pageTitle = "Hệ thống quản lý giải đua F1";
    }
%>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= HtmlUtil.escape(pageTitle) %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .action-control {
            border: 1px solid #cbd5e1;
            border-radius: .5rem;
            background: #e2e8f0;
            color: #334155;
            font-weight: 700;
            transition: background-color .16s ease, border-color .16s ease, color .16s ease, transform .16s ease;
        }
        .action-control:hover {
            border-color: #dc2626;
            background: #dc2626;
            color: #fff;
        }
        .action-control:focus-visible { outline: 2px solid #fca5a5; outline-offset: 2px; }
        .page-kicker { color: #dc2626; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
        .table-f1 th {
            background-color: #1e293b;
            color: #ffffff;
            font-weight: 600;
            font-size: 13px;
            padding: 10px 14px;
            text-align: left;
            border: 1px solid #334155;
        }
        .table-f1 td {
            padding: 10px 14px;
            font-size: 13.5px;
            border: 1px solid #cbd5e1;
            color: #1e293b;
        }
        .table-f1 tbody tr:nth-child(even) {
            background-color: #f8fafc;
        }
        .table-f1 tbody tr:hover {
            background-color: #f1f5f9;
        }
    </style>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900 flex flex-col">
<% if (btcNav != null) { %>
<header class="bg-slate-900 text-white border-b-4 border-red-600 shadow-md">
    <div class="max-w-6xl w-full mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <a href="<%= ctx %>/gdChinhBTC.jsp" class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-lg bg-red-600 flex items-center justify-center font-extrabold text-lg tracking-tighter">F1</span>
            <span>
                <span class="block font-bold leading-tight">Quản lý giải đua xe F1</span>
                <span class="block text-xs text-slate-400">Hệ thống điều hành giải đua</span>
            </span>
        </a>
        <div class="flex items-center gap-3">
            <div class="text-right hidden sm:block">
                <div class="text-sm font-semibold"><%= HtmlUtil.escape(navHoTen) %></div>
                <div class="text-xs text-slate-400"><%= HtmlUtil.escape(navViTri) %></div>
            </div>
            <a href="<%= ctx %>/dangXuat.jsp"
               class="action-control px-3 py-2 text-sm">
                Đăng xuất
            </a>
        </div>
    </div>
</header>
<% } %>
<main class="max-w-6xl w-full mx-auto px-4 py-8 sm:py-10 flex-1">
